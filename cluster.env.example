# ============================================================================
# cluster.env — single source of cluster constants for the Inkling-Small-NVFP4
# 2x DGX Spark deployment. Sourced by every script in this repo.
#
# SETUP: copy to cluster.env and edit the blocks marked [SITE].
# Everything else is a tuned default — the rationale comments explain WHY each
# value was chosen (they are the hard-won part of this repo; keep them).
#
# TRAP REMINDERS (each one cost an outage):
#   - NEVER put '#' comments inside the compose command scalar — it is a folded
#     shell string, so '#' comments out EVERYTHING after it. Rationale lives HERE.
#   - Unquoted heredocs (render-env.sh): '#' is literal text and $VAR still
#     expands — keep "commented-out" lines dollar-free.
# ============================================================================

# --- [SITE] identity (mDNS names or static IPs; do not use drifting DHCP) ---
HEAD_HOST=spark1.local              # rank 0 / API node — EDIT ME
WORKER_HOST=spark2.local            # rank 1 — EDIT ME
CLUSTER_USER=nvidia                 # user on both nodes (docker group; linger on)
KIT_DIR=/home/nvidia/inkling-small-nvfp4  # NOTE: systemd units hardcode this default path — if you change it, also edit systemd/*.service

# --- [SITE] QSFP fabric: direct Spark-to-Spark cable, two rails --------------
# The 2x Spark kit links the nodes with a QSFP DAC. Each port exposes two PCIe
# "twin" interfaces; NCCL merges both for ~23 GB/s RDMA. Assign STATIC IPs on
# both rails (netplan), MTU 9000. Defaults below match docs/NETWORKING.md.
QSFP_IF=enp1s0f1np1                 # rail 1 (control/bootstrap + master-addr)
QSFP_IF2=enP2p1s0f1np1              # rail 2 (PCIe twin of the same port)
HEAD_R1=192.168.177.10
WORKER_R1=192.168.177.11
HEAD_R2=192.168.178.10
WORKER_R2=192.168.178.11
MTU=9000

# --- NCCL / transports (proven on the fabric above — copy verbatim) ----------
NCCL_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1 # dual-twin RDMA
NCCL_IB_GID_INDEX=                  # empty → auto-select
NCCL_CROSS_NIC=1
NCCL_IB_MERGE_NICS=1                # dual-HCA merge → the ~23 GB/s path
NCCL_NET=IB
NCCL_IB_DISABLE=0
TP_SOCKET_IFNAME=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_ADDR_FAMILY=AF_INET         # RoCEv2 IPv4
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_ADDR_RANGE=
NCCL_DEBUG=WARN
NCCL_DEBUG_SUBSYS=

# --- serving image -----------------------------------------------------------
# Thin overlay on the official arm64 vLLM v0.26.0 (image/Dockerfile):
#   + scipy (Inkling's model class imports linear_sum_assignment at construction)
#   + einops + apache-tvm-ffi (FA4 bundle deps)
#   + fa4_sm120_shim.py (.pth autoload) — REQUIRED on SM12x, see docs/KERNEL-FIX.md:
#     vLLM's bundled FA4 asserts "Paged KV not supported on SM 12.0", so the shim
#     redirects to SecondNatureComputing/flash-attn-4-sm120 AND applies two
#     load-bearing fixes for its varlen path (clamped score_mod + batch-split).
INKLING_VLLM_IMAGE=vllm-inkling-runtime:v026-scipy-fa4sm120

# --- model / weights (public, Apache-2.0, no HF token; ~160 GiB per node) ----
INKLING_MODEL=thinkingmachines/Inkling-Small-NVFP4
SERVED_MODEL_NAME=inkling-small-nvfp4
HF_CACHE=/home/nvidia/hf-cache-inkling   # mounted at /cache/huggingface

# --- [SITE] API (loopback only; front with a reverse proxy / SSH tunnel) -----
VLLM_HOST=127.0.0.1
API_PORT=8001

# --- serve profile -----------------------------------------------------------
# Two profiles (full sizing math + gates: docs/CONTEXT-1M.md):
#
#   DEFAULT (throughput): 131,072 ctx, MNBT 8192, util 0.85, seqs 8
#     → MEASURED KV pool 213,780 tokens. Fast prefill.
#   1M LANE (long context): 1,048,576 ctx, MNBT 768, seqs 2, util 0.80 +
#     KV_CACHE_MEMORY_BYTES=29.5 GiB → MEASURED KV pool 2,044,677 tokens
#     (1.95× the window; bf16 KV — no fp4 KV for this model on vLLM; see
#     docs/CONTEXT-1M.md). Very long prefills are SLOW (768-token chunks;
#     minutes for ≥256K prompts).
#
# KV math (bf16, MEASURED): only 7/42 layers are global attention and vLLM's
# hybrid allocator caps SWA/conv state per request (constant vs context), so
# the pool costs ~15.5 KiB/token/node (≈28 KiB cluster-wide) and does NOT
# shrink as MAX_MODEL_LEN grows — it only has to cover one full-length
# request. 1M tokens ≈ 15.9 GiB/node — cheap; what made 1M unreachable via
# the util lever is the profiler's workspace reservation (~11 GiB @MNBT 1024,
# ~22 GiB @8192), which the byte-pin below bypasses.
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=8                      # 121 GiB UMA per node; the recipe's 256 is for H200x2
MAX_NUM_BATCHED_TOKENS=8192         # recipe default; prefill chunk size
GPU_MEMORY_UTILIZATION=0.85         # 0.88/0.90 sit inside the boot-time device-free
                                    # fluctuation band and failed vLLM's startup check
                                    # intermittently; 0.85 clears the worst observed
                                    # dip by ~3.3 GiB. BOTH NODES OR NEITHER (parity).
KV_CACHE_MEMORY_BYTES=              # empty = profiler sizes the pool

# === 1M-CONTEXT LANE (uncomment these 5 lines AND comment out the 4 above) ===
# MAX_MODEL_LEN=1048576             # native ceiling; the pool must cover ONE such request
# MAX_NUM_SEQS=2                    # full-length work is single-stream (pool = 1.95 requests)
# MAX_NUM_BATCHED_TOKENS=768        # small activation workspace; slow long prefills
# GPU_MEMORY_UTILIZATION=0.80       # startup GATE only (free >= util*total, unconditional)
                                    # — 0.80 always passes; the pin sizes the pool and
                                    # "does not respect gpu_memory_utilization"
                                    # (gpu_worker.py). BOTH NODES OR NEITHER.
# KV_CACHE_MEMORY_BYTES=31675322368 # 29.5 GiB → MEASURED pool 2,044,677 tokens.
                                    # Envelope: 78.3 weights + 29.5 KV + ~1.5 ws ≈ 109 GiB.
                                    # Trim to ~17 GiB (≈1.1M pool) for more system margin.
                                    # With MTP_NUM_TOKENS=1 use 30601641984 (28.5 GiB —
                                    # 1 GiB drafter headroom) → measured pool 1,950,538.
# Boot gate: journalctl --user -u vllm-inkling-head | grep -i 'kv cache'
#   → 'GPU KV cache size' must be ≥ 1,048,576 tokens.
KV_CACHE_MEMORY_BYTES=              # empty = profiler sizes the pool
MOE_BACKEND=                        # empty = per-family auto. Inkling has TWO MoE
                                    # families (NVFP4 routed + BF16 shared experts);
                                    # a global --moe-backend must satisfy both —
                                    # 'cutlass' hard-fails on the unquantized family.
MTP_NUM_TOKENS=                     # MTP speculative decoding: OFF at baseline
                                    # (SM121 99 KB SMEM + K=128 tile history).
                                    # Only 1 is valid — vLLM 0.26 hard-rejects
                                    # n!=1 for inkling_mtp (speculative.py:
                                    # "exactly one speculative token").
                                    # MEASURED 2026-08-02 (1M lane): C1 21.72 →
                                    # 29.21 tok/s (+34.5%), acceptance 0.50-0.55;
                                    # C2 −3.6% (lane is single-stream-first).
                                    # On the 1M lane also shave the KV pin to
                                    # 28.5 GiB (see the 1M block above).
REASONING_EFFORT=high               # Inkling chat-template dial: none|minimal|low|
                                    # medium|high|max or 0.0-0.99. Empty = template
                                    # default 0.9. NOTE: thinking shares the output
                                    # budget — small max_tokens truncates to empty
                                    # content with finish=length.
DISABLE_CUSTOM_ALL_REDUCE=1         # cross-node mp-executor safety lever (#41725
                                    # class); PYNCCL only. Measured cost: none at TP=2.
ENFORCE_EAGER=1                     # REQUIRED. Piecewise/breakable cudagraphs crash
                                    # cross-node ("input tensor addresses changed
                                    # between capture and replay", #46253 class).
                                    # Perf penalty accepted; re-test graphs later.
SHUTDOWN_TIMEOUT=30

# --- [SITE] distributed rendezvous (vLLM native mp backend, no Ray) ----------
# MUST equal HEAD_R1 above — if you change the rail IPs, change this too.
MASTER_ADDR=192.168.177.10          # = HEAD_R1
MASTER_PORT=25001

# --- ops knobs ---------------------------------------------------------------
WORKER_WAIT_SECS=600
BOOT_DEP_WAIT_SECS=300

# --- engine safety + cache knobs ---------------------------------------------
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=600   # TP-worker forward-pass RPC timeout;
                                         # upstream default 300s is tight for 100K+
                                         # prefills.
TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas   # Triton's bundled ptxas lacks sm_121a
VLLM_LOGGING_LEVEL=INFO

# --- FA4 SM120 kernel fix (docs/KERNEL-FIX.md) --------------------------------
# Leave FA4_BUNDLE_DIR EMPTY: the shim's clamped score_mod + batch-split fixes are
# the load-bearing ones and work with the STOCK bundle. A hardened bundle copy
# (page-table clamps, stage-1 paged) can be generated with
# image/patch-fa4-bundle.sh and pointed at here — proven NOT load-bearing.
# SHIM_PATH empty = $KIT_DIR/image/fa4_sm120_shim.py (bind-mounted into the
# container; the mount is load-bearing — the image's baked-in shim lacks the fixes).
FA4_BUNDLE_DIR=
SHIM_PATH=

# Other big workloads on these nodes that Inkling cannot coexist with (memory).
# Preflight hard-fails if any of these containers/units are active. Reference
# cluster runs a DeepSeek stack as vllm-dsv4 — replace with your own (or empty).
CONFLICT_CONTAINERS="vllm-dsv4"
CONFLICT_UNITS="vllm-dsv4-head.service vllm-dsv4-worker.service"
